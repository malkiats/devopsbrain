# DevOpsBrain — local development & Vercel environment variables
# This file is gitignored. Copy to .env and fill in your values.
# On Vercel, set these in the project's Environment Variables dashboard.

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=DevOpsBrain API
APP_ENV=production
APP_VERSION=0.1.0

# ── OpenAI ───────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Supabase / PostgreSQL ─────────────────────────────────────────────────────
POSTGRES_URL=postgres://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&supa=base-pooler.x
POSTGRES_DSN=postgres://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Redis (optional, leave default for local dev) ────────────────────────────
REDIS_URL=redis://localhost:6379/0
